# Environment configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bracu_rag

# OpenRouter LLM API (Gemini 3.8 Flash)
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_REWRITE_MODEL=amazon/nova-lite-v1
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_MAX_COMPLETION_TOKENS=1500
OPENROUTER_FALLBACK_MODELS=z-ai/glm-4.7-flash,z-ai/glm-5.3-flashx,google/gemini-3.8-flash,qwen/qwen3.7-flash,mistralai/mistral-small-24b-instruct-2501,google/gemma-3-12b-it,amazon/nova-lite-v1,meta-llama/llama-3.1-8b-instruct,openai/gpt-oss-120b,openai/gpt-oss-20b

# Groq LLM API (Fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_REWRITE_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=medium
GROQ_MAX_COMPLETION_TOKENS=1200

# AI Models (Local)
HF_TOKEN=your_hugging_face_access_token_here
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval & RAG Parameters
RETRIEVAL_TOP_K=10
RETRIEVAL_DOCUMENT_LIMIT=3
RERANK_TOP_N=5
SIMILARITY_THRESHOLD=0.5
RETRIEVAL_FAISS_WEIGHT=0.25
RETRIEVAL_TEXT_WEIGHT=1.0
CHAT_HISTORY_TURNS=6
KB_SOURCE_DIR=c:/Users/tarek/Desktop/brac-rag/output

# Security & Authentication
JWT_SECRET=brac_rag_dev_secret_key_change_in_production_987654321
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000


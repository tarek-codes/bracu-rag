# Environment configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/bracu_rag

# OpenRouter LLM API
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_REWRITE_MODEL=amazon/nova-lite-v1
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_MAX_COMPLETION_TOKENS=1500
OPENROUTER_FALLBACK_MODELS=z-ai/glm-4.7-flash,z-ai/glm-5.3-flashx,google/gemini-3.8-flash,qwen/qwen3.7-flash,mistralai/mistral-small-24b-instruct-2501,google/gemma-3-12b-it,amazon/nova-lite-v1,meta-llama/llama-3.1-8b-instruct,openai/gpt-oss-120b,openai/gpt-oss-20b

# Groq LLM API (Fallback / Alternative)
GROQ_API_KEY=
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_REWRITE_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=medium
GROQ_MAX_COMPLETION_TOKENS=1200

# AI Models (Local)
HF_TOKEN=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval & RAG Parameters
RETRIEVAL_TOP_K=10
RERANK_TOP_N=5
SIMILARITY_THRESHOLD=0.5
RETRIEVAL_FAISS_WEIGHT=0.25
RETRIEVAL_TEXT_WEIGHT=1.0
CHAT_HISTORY_TURNS=6
KB_SOURCE_DIR=

# Security & Authentication
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000

# Chroma Vector DB (Chroma Cloud)
CHROMA_API_KEY=
CHROMA_HOST=api.trychroma.com
CHROMA_TENANT=
CHROMA_DATABASE=rag
CHROMA_COLLECTION_NAME=rag

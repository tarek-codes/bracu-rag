# Environment configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database (PostgreSQL 18.6 with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bracu_rag

# Groq LLM API
GROQ_API_KEY=your_groq_api_key_here
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_REWRITE_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=medium
GROQ_MAX_COMPLETION_TOKENS=1200

# AI Models (Local)
HF_TOKEN=your_hugging_face_access_token_here
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval & RAG Parameters
RETRIEVAL_TOP_K=10
RERANK_TOP_N=5
SIMILARITY_THRESHOLD=0.5
RETRIEVAL_FAISS_WEIGHT=0.25
RETRIEVAL_TEXT_WEIGHT=1.0
CHAT_HISTORY_TURNS=6
KB_SOURCE_DIR=/home/tarek11/Desktop/bracu_RAG/output

# Security & Authentication
JWT_SECRET=change_this_to_a_secure_random_secret_in_production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000
